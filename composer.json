{
    "name": "mohamedhekal/classbridge",
    "description": "Unified Laravel classroom abstraction for live sessions, participants, permissions, and recordings",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "classroom",
        "livekit",
        "video",
        "education",
        "edtech",
        "php",
        "laravel-package"
    ],
    "authors": [
        {
            "name": "Mohamed Hekal"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "homepage": "https://github.com/mohamedhekal/classbridge",
    "support": {
        "issues": "https://github.com/mohamedhekal/classbridge/issues",
        "source": "https://github.com/mohamedhekal/classbridge"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Hekal\\ClassBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hekal\\ClassBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hekal\\ClassBridge\\ClassBridgeServiceProvider"
            ],
            "aliases": {
                "ClassBridge": "Hekal\\ClassBridge\\Facades\\ClassBridge"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
