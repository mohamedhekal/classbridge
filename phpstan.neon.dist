includes:
  - vendor/larastan/larastan/extension.neon
  # Remaining model-typing findings (casts / relation generics) tracked as known debt.
  - phpstan-baseline.neon

parameters:
  paths: [src]
  level: 6
  treatPhpDocTypesAsCertain: false
  databaseMigrationsPath: [database/migrations]
  ignoreErrors:
    - '#return type with generic class Illuminate\\Database\\Eloquent\\Relations\\#'
